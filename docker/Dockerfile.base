# BraTS 2026 Task 3 final image: stock five-fold nnU-Net with mirroring TTA.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    nnUNet_raw=/opt/nnunet/raw \
    nnUNet_preprocessed=/opt/nnunet/preprocessed \
    nnUNet_results=/opt/nnunet/results \
    BRATS_NNUNET_DATASET=501 \
    BRATS_NNUNET_CONFIG=3d_fullres \
    BRATS_NNUNET_TRAINER=nnUNetTrainer \
    BRATS_NNUNET_PLANS=nnUNetPlans \
    BRATS_NNUNET_FOLDS="0 1 2 3 4" \
    BRATS_ENABLE_TTA=1

WORKDIR /opt/app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir '.[inference]'

# Generated by scripts/prepare_submission_model_base.sh.
COPY work/submission_model_base/nnUNet_results/ /opt/nnunet/results/
RUN mkdir -p /opt/nnunet/raw /opt/nnunet/preprocessed

COPY docker/run_inference.py /opt/app/run_inference.py
ENTRYPOINT ["python", "/opt/app/run_inference.py"]
